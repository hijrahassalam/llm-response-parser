{
  "name": "llm-response-parser",
  "version": "1.0.0",
  "description": "Universal LLM response parser — normalize any provider's response into a consistent format.",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "llm-parse": "./bin/cli.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./stream": "./src/stream.js",
    "./providers": "./src/providers.js"
  },
  "scripts": {

    "lint": "node --check src/**/*.js"
  },
  "keywords": [
    "llm",
    "response-parser",
    "openai",
    "anthropic",
    "mimo",
    "deepseek",
    "streaming",
    "tool-calling",
    "normalizer",
    "zero-deps"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
